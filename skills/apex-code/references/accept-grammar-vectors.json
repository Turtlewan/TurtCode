  },
  {
    "text": "Write-Output 'cd Set-Location Push-Location'",
    "expected": "accept"
  },
  {
    "text": "# cd /root\nWrite-Output ok",
    "expected": "accept"
  },
  {
    "text": "Write-Output 'prefix C:/repo'",
