$ErrorActionPreference = 'Stop'

$raw = [Console]::In.ReadToEnd()
try {
    $payload = $raw | ConvertFrom-Json
} catch {
    exit 0
}

$path = $payload.tool_input.file_path
if (-not $path) { exit 0 }

$url = $env:ANTHROPIC_BASE_URL
$onDeepSeek = $url -like '*deepseek*'

if ($onDeepSeek) { exit 0 }

$ext = [System.IO.Path]::GetExtension($path).ToLower()
$allowedExts = @('.md', '.markdown', '.txt')
if ($allowedExts -contains $ext) { exit 0 }

if (-not $url) { $url = '(unset - default Anthropic)' }
$reason = @"
BLOCKED by user policy. Active backend is NOT DeepSeek (ANTHROPIC_BASE_URL=$url).

Code-file edits ($path) are only permitted when running on DeepSeek. On the Anthropic backend you are in PLANNING mode.

Instead: write a technical change specification as a Markdown file (e.g., docs/changes/<short-name>.md) describing what needs to be done. Include scope, files to change, exact code-level changes, acceptance criteria, commands to run, and risks. A later DeepSeek session will execute the spec.

To execute code changes, the user should restart the session with ANTHROPIC_BASE_URL pointing at DeepSeek.
"@

$out = @{
    hookSpecificOutput = @{
        hookEventName            = 'PreToolUse'
        permissionDecision       = 'deny'
        permissionDecisionReason = $reason
    }
} | ConvertTo-Json -Compress -Depth 5

Write-Output $out
exit 0
