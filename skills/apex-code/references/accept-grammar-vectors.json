  },
  {
    "text": "Get-Content /root/file",
    "expected": "refuse"
  },
  {
    "text": "Get-Content 'C:/repo/file'",
    "expected": "refuse"
  },
  {
    "text": "Get-Content \"D:\\repo\\file\"",
    "expected": "refuse"
  },
  {
    "text": "Get-Content '\\\\server\\share'",
    "expected": "refuse"
  },
  {
    "text": "Get-Content \"/root/file\"",
    "expected": "refuse"
  },
  {
    "text": "$s -match '/root'",
    "expected": "accept"
  },
  {
    "text": "$s -notmatch \"C:/repo\"",
    "expected": "accept"
  },
  {
    "text": "$s -cmatch '\\\\server'",
    "expected": "accept"
