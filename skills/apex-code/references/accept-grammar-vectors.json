  {
    "text": "cd src",
    "expected": "refuse"
  },
  {
    "text": "Set-Location src",
    "expected": "refuse"
  },
  {
    "text": "push-location src",
    "expected": "refuse"
  },
  {
    "text": "& 'Set-Location' src",
    "expected": "refuse"
  },
  {
    "text": "Write-Output ok | Set-Location src",
    "expected": "refuse"
  },
  {
    "text": "Write-Output ok; CD src",
    "expected": "refuse"
  },
  {
    "text": "Write-Output cd Set-Location Push-Location",
